    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "dev": "tauri dev",
    "dev:web": "bun run dev:frontend",
    "dev:frontend": "bunx --bun vite",
    "build": "tauri build",
    "build:web": "bun run build:frontend",
    "build:frontend": "rm -rf dist && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
